# Windows reserved names
nul

# Dependencies
node_modules/

# Build outputs
dist/
build/
__pycache__/
*.pyc

# Runtime
daon_runtime/*
!daon_runtime/laya_service.py
server.pid

# Data (user-specific)
# data/  ->  data/*  (2026-10-13 MCP 카탈로그 배포 수정)
#   git 은 부모 디렉토리가 통째로 제외되면 그 안의 파일을 '!' 로 재포함할 수 없다.
#   'data/*' 는 data/ 디렉토리 자체는 제외하지 않고 내용만 무시하므로
#   아래 예외가 유효해진다. 나머지 data/ 내용은 계속 무시된다.
data/*
!data/mcp_catalog.json

# Environment
.env
.env.bak.*

# IDE
.vscode/
.idea/
.serena/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
*.txt

# Temp
*.tmp
extracted_asar/
test_app_unpacked/
clean_build_unpacked/

# Harness run artifacts (runtime-generated, not source)
final_output.md
metadata.json
metrics.json

# Runtime-generated media (agent-created praise/media files)
static/media_*
dist_new/
dist_old_*/

# One-off analysis / diff scratch files
_*.py
!**/__init__.py
_*.txt
_*.bak
_tmp_*

# Evidence suite scratch dumps (determinism debugging — not source)
all_a.json
all_b.json
run1.json
run2.json
t01a.json
t01b.json

# Evidence suite deterministic workdir (regenerated each run — not source)
evidence/_workdir/

# Release artifacts — ignore large binaries, keep scripts/README tracked
release/*.exe
release/*.zip
release/*.yml
release/win-unpacked/
release/_stage/
release/_archive/

# 지인 배포용 산출물 (Setup.exe + win-unpacked = 수백 MB 바이너리, 소스 아님)
release_friend/

# 빌드 중 생성되는 임시 백업 (build_friend_release.ps1)
_friend_build_backup_*/

# Windows 예약 장치명이 하위 경로에 생성된 경우 (셸 리다이렉트 사고)
**/nul
**/nul.*

# 타임스탬프 백업 사본 (스토어/설정 저장 시 자동 생성)
*.bak-*

# Electron builder config (duplicated from package.json)
electron-builder.yml

# Scratch
scratch/

# asar 재패키징 중간 산출물 (핫스왑용 임시 파일)
.asar-stage/
app.asar.new
app.asar.new.bak*
