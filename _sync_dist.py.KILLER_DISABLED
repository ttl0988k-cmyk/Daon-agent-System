#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""일회용: 원본 수정 파일을 dist_new 미러로 동기화 (파일 잠금 재시도 포함)."""
import shutil
import os
import sys
import time

ROOT = os.path.dirname(os.path.abspath(__file__))


def _p(rel):
    return os.path.join(ROOT, rel.replace('/', os.sep))


PAIRS = [
    (_p('api/api/memory_store.py'), _p('dist_new/api/api/memory_store.py')),
    (_p('api/api/streaming.py'), _p('dist_new/api/api/streaming.py')),
    (_p('api/api/routes/__init__.py'), _p('dist_new/api/api/routes/__init__.py')),
    (_p('api/api/routes/admin_routes.py'), _p('dist_new/api/api/routes/admin_routes.py')),
    (_p('static/modules/panels.js'), _p('dist_new/static/modules/panels.js')),
]

ok = []
fail = []

for src, dst in PAIRS:
    done = False
    last = None
    for attempt in range(8):
        try:
            if os.path.exists(dst):
                try:
                    os.chmod(dst, 0o777)
                except Exception:
                    pass
                try:
                    os.remove(dst)
                except Exception:
                    pass
            shutil.copyfile(src, dst)
            ok.append(dst)
            done = True
            break
        except Exception as e:
            last = e
            time.sleep(2.0)
    if not done:
        fail.append((dst, str(last)))

print('OK:', len(ok))
for x in ok:
    print('  +', x)
print('FAIL:', len(fail))
for x in fail:
    print('  -', x[0], '::', x[1])

sys.exit(1 if fail else 0)
